# FeedEater environment — copy to .env and fill in.
# .env is gitignored and is the single source of truth for deployment secrets (agent.md).
# Never commit it.

# --- Required (checked by Makefile:deploy) ---

# 32-byte base64 key encrypting module secrets at rest. Generate ONCE:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# NEVER regenerate without first clearing encrypted values from the Setting table
# (a mismatch crashes the API at startup — see agent.md).
FEED_SETTINGS_KEY=

# Random token shared by worker→api for /api/internal/* endpoints. Generate:
#   openssl rand -hex 32
FEED_INTERNAL_TOKEN=

# --- AI providers (OpenAI-compatible /v1 endpoints; any conforming provider works) ---

AI_BASE_URL=http://spark-ddb1.tailbdd59.ts.net:8888/v1
AI_EMBED_BASE_URL=http://spark-ddb1.tailbdd59.ts.net:8889/v1
AI_EMBED_DIM=768

# --- Compose defaults (override only if needed) ---

# POSTGRES_USER=feedeater
# POSTGRES_PASSWORD=feedeater
# POSTGRES_DB=feedeater
# DATABASE_URL=postgresql://feedeater:feedeater@postgres:5432/feedeater
# NATS_URL=nats://nats:4222
