{
  "name": "system",
  "version": "0.0.1",
  "namespace": "feedeater.system",
  "runtime": { "entry": "dist/runtime.js" },
  "queues": ["mod_system"],
  "jobs": [
    {
      "name": "aiDebug",
      "queue": "mod_system",
      "description": "Probe both AI endpoints (summary and embed) and report health metrics."
    }
  ],
  "settings": [
    { "key": "jetstream_max_age_seconds", "type": "number", "default": 2592000 },
    { "key": "dashboard_bus_history_minutes", "type": "number", "default": 60 },
    { "key": "dashboard_bus_limit", "type": "number", "default": 200 },
    { "key": "dashboard_bus_filter_module", "type": "string", "default": "" },
    { "key": "dashboard_bus_filter_stream", "type": "string", "default": "" },
    { "key": "dashboard_bus_search", "type": "string", "default": "" },
    { "key": "dashboard_narratives_history_minutes", "type": "number", "default": 60 },
    { "key": "dashboard_narratives_limit", "type": "number", "default": 200 },
    { "key": "dashboard_narratives_filter_module", "type": "string", "default": "" },
    { "key": "dashboard_narratives_search", "type": "string", "default": "" },
    { "key": "ai_base_url", "type": "string", "default": "" },
    { "key": "ai_summary_model", "type": "string", "default": "Qwen/Qwen3-Coder-Next-FP8" },
    { "key": "ai_api_key", "type": "string", "default": "" },
    { "key": "ai_embed_base_url", "type": "string", "default": "" },
    { "key": "ai_embed_model", "type": "string", "default": "BAAI/bge-base-en-v1.5" },
    { "key": "ai_embed_dim", "type": "number", "default": 768 },
    { "key": "ai_burst_enabled", "type": "boolean", "default": false },
    { "key": "ai_burst_base_url", "type": "string", "default": "https://api.together.xyz/v1" },
    { "key": "ai_burst_api_key", "type": "string", "default": "" },
    { "key": "ai_burst_summary_model", "type": "string", "default": "Qwen/Qwen3-Coder-Next-FP8" },
    { "key": "ollama_base_url", "type": "string", "default": "" },
    { "key": "ollama_summary_model", "type": "string", "default": "" },
    { "key": "ollama_embed_model", "type": "string", "default": "" },
    { "key": "ollama_embed_dim", "type": "number", "default": 768 },
    { "key": "narrative_top_k", "type": "number", "default": 20 },
    { "key": "dashboard_show_ids", "type": "boolean", "default": false }
  ],
  "cards": [{ "id": "systemStatus", "title": "System" }]
}
