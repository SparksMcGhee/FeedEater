{
  "name": "feedeater",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run -ws dev",
    "build": "npm run -ws build",
    "typecheck": "npm run -ws typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "vitest": "^5.0.1"
  }
}
