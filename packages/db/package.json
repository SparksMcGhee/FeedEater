{
  "name": "@feedeater/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts --format esm --dts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/migrate.js",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
